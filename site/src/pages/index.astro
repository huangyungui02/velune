---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="page" id="top">
    <header class="hero">
      <div class="hero-mark reveal" data-parallax="0.12" aria-hidden="true"></div>
      <p class="eyebrow reveal">Glimmer · Resonance · Echo</p>
      <h1 class="reveal">Aevra</h1>
      <p class="hero-copy reveal">
        Begin with a Glimmer from your inner world.<br />
        Receive an Echo in resonance with your depth.
      </p>
      <div class="hero-actions reveal">
        <a class="btn btn-solid" href="#essence">Enter Aevra</a>
        <a class="btn btn-ghost" href="#journey">Explore</a>
      </div>
    </header>

    <section id="essence" class="split reveal">
      <div>
        <p class="kicker">Essence</p>
        <h2>Not a tool, but a vessel.</h2>
      </div>
      <p>
        In this noisy digital expanse,<br />
        Aevra stands as a quiet vessel.<br />
        It holds your Glimmer, reflecting a Resonance across time and space.
      </p>
    </section>

    <section class="feature-grid">
      <article class="feature-card reveal tilt-card">
        <p class="feature-index">01</p>
        <h3>Glimmer</h3>
        <p>A spark from within. Capture the fleeting, authentic thoughts that define you.</p>
      </article>
      <article class="feature-card reveal tilt-card">
        <p class="feature-index">02</p>
        <h3>Resonance</h3>
        <p>A minimalist void where the spirit flows freely, finding a kindred frequency.</p>
      </article>
      <article class="feature-card reveal tilt-card">
        <p class="feature-index">03</p>
        <h3>Echo</h3>
        <p>Connect with the universal. Hear the thunder in silence, find yourself in the echo.</p>
      </article>
    </section>

    <section id="journey" class="journey reveal">
      <h2>Three Movements of the Soul</h2>
      <ol>
        <li class="tilt-card">
          <span>I</span>
          <div>
            <h4>Glimmer</h4>
            <p>Cast your inner light into the void, like a star in the dark sky.</p>
          </div>
        </li>
        <li class="tilt-card">
          <span>II</span>
          <div>
            <h4>Resonance</h4>
            <p>The algorithm traces emotional textures, seeking a kindred frequency.</p>
          </div>
        </li>
        <li class="tilt-card">
          <span>III</span>
          <div>
            <h4>Echo</h4>
            <p>Receive not just a reply, but a reflection from another dimension of self.</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="quote reveal tilt-card">
      <blockquote>To see the universe in the void, to hear thunder in silence.</blockquote>
    </section>

    <footer class="footer reveal">
      <a href="#top">Aevra</a>
      <p>Glimmer · Resonance · Echo</p>
      <nav class="legal-links" aria-label="Legal">
        <a href="/terms">Terms</a>
        <span aria-hidden="true">/</span>
        <a href="/privacy">Privacy</a>
        <span aria-hidden="true">/</span>
        <a href="/zh/">中文</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealEls = Array.from(document.querySelectorAll(".reveal"));
  const canAnimateReveal = !prefersReducedMotion && "IntersectionObserver" in window;

  if (canAnimateReveal && revealEls.length > 0) {
    document.documentElement.classList.add("js-reveal");
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    revealEls.forEach((el) => obs.observe(el));

    // Safari fallback: if observer misses initial paint, force reveal.
    window.setTimeout(() => {
      revealEls.forEach((el) => el.classList.add("is-visible"));
    }, 1200);
  }

  if (!prefersReducedMotion) {
    const parallaxTargets = Array.from(document.querySelectorAll("[data-parallax]"));
    const onScroll = () => {
      const y = window.scrollY;
      parallaxTargets.forEach((el) => {
        const factor = Number(el.getAttribute("data-parallax") || 0.1);
        (el as HTMLElement).style.transform = `translate3d(0, ${y * factor}px, 0)`;
      });
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const tiltCards = Array.from(document.querySelectorAll<HTMLElement>(".tilt-card"));
    tiltCards.forEach((card) => {
      card.addEventListener("pointermove", (e: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        const rotateY = (px - 0.5) * 4; // Reduced rotation for more subtlety
        const rotateX = (0.5 - py) * 3;
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        card.style.setProperty("--glow-x", `${px * 100}%`);
        card.style.setProperty("--glow-y", `${py * 100}%`);
      });
      card.addEventListener("pointerleave", () => {
        card.style.transform = "";
      });
    });
  } else {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  }
</script>
